# Example .env for Gmail SMTP
# Copy this to .env and fill in real values (DO NOT COMMIT .env with secrets)

# Flask secret
SECRET_KEY=replace-with-a-secret

# Database creds (example placeholders)
BLOG_DB_USER=your_db_user
BLOG_DB_PW=your_db_password

# Gmail SMTP (use an App Password if you have 2FA enabled)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USE_SSL=False
MAIL_USERNAME=your.email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_DEFAULT_SENDER='Your App <noreply@yourdomain.com>'

# Notes:
# - For Gmail, enable 2FA on the account and create an "App Password" specifically for SMTP.
# - Alternatively, use a transactional provider like SendGrid/Mailgun for production.
# - Keep this file out of source control; use environment variables in deployment.
